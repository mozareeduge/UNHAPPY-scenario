{
  "schema_version": "1.0.0",
  "checks": [
    {
      "id": "visible-setup",
      "command": [
        "python",
        "project-relay/tools/check_repo_visibility.py",
        "--repo",
        "."
      ],
      "timeout_seconds": 60,
      "requirements": [
        "R3"
      ],
      "scenarios": [
        "transparent setup"
      ]
    },
    {
      "id": "static-artwork",
      "command": [
        "python",
        "project-relay/tools/static_artwork_check.py"
      ],
      "timeout_seconds": 60,
      "requirements": [
        "R1",
        "R2",
        "R4",
        "R6"
      ],
      "scenarios": [
        "locked text",
        "offline assets"
      ]
    },
    {
      "id": "browser-qa",
      "command": [
        "python",
        "tests/qa.py"
      ],
      "timeout_seconds": 1200,
      "requirements": [
        "R1",
        "R2",
        "R5",
        "R6",
        "R7"
      ],
      "scenarios": [
        "full automated browser matrix"
      ]
    }
  ]
}
